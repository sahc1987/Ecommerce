PORT=5000
DATABASE_URL=postgresql://user:password@localhost:5432/ecommerce
JWT_SECRET=your_super_secret_jwt_key_here
CLIENT_URL=http://localhost:5173
# Set to "true" when the frontend is on a different domain than the backend
# (e.g. Cloudflare Pages + Render). Enables SameSite=None; Secure auth cookies.
CROSS_SITE_COOKIES=false
REDIS_URL=redis://:your_redis_password@localhost:6379

# Cloudinary (image storage). If unset, uploads are written to local disk (dev only,
# not persisted on ephemeral cloud hosts). Set all three to enable Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: folder name for uploaded images (default: ecommerce)
CLOUDINARY_FOLDER=ecommerce

# Stripe (card payments via hosted Checkout). If STRIPE_SECRET_KEY is unset,
# checkout offers Cash on Delivery only. Use sk_test_… keys in development.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (/api/payments/webhook). Locally, get it
# from `stripe listen --forward-to localhost:5000/api/payments/webhook`.
STRIPE_WEBHOOK_SECRET=
