# Text files are committed with LF whatever the editor or core.autocrlf setting,
# so diffs show real changes, not line-ending churn.
* text=auto eol=lf

# Windows scripts need CRLF to run.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binaries: never convert or diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.jar binary
*.keystore binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
