# Secrets below are required: Docker Compose refuses to start while any is empty.
# Generate each with:  openssl rand -hex 32

# Database Configuration
DB_NAME=ecommerce
DB_USER=ecommerce_user
DB_PASSWORD=
DB_PORT=5432

# Redis Configuration
REDIS_PASSWORD=

# Backend Configuration
BACKEND_PORT=5000
NODE_ENV=production
JWT_SECRET=
CLIENT_URL=http://localhost

# Frontend Configuration
FRONTEND_PORT=80
# Empty = the website calls /api on its own address and nginx forwards it.
# Set a full URL (https://api.example.com/api) only when the API is on another domain.
VITE_API_URL=

# General
TZ=UTC

# Stripe (card payments). Leave empty to offer Cash on Delivery only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
